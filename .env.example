# PostgreSQL connection. For docker-compose, the service config supplies DATABASE_URL.
DATABASE_URL=postgres://backendquest:change-this-local-password@localhost:5432/backendquest
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Comma-separated exact browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080
PORT=8080
NODE_ENV=development
TRUST_PROXY=false
FRONTEND_DIST=dist
LOG_LEVEL=info

# Vite uses /api/v1 by default. Development requests are proxied to this target.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional values used when running inside Google AI Studio.
GEMINI_API_KEY=
APP_URL=
